# Copy this file to .env. Never commit the completed .env file.

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Start the local database with: docker compose up -d
DB_URL=jdbc:postgresql://127.0.0.1:5433/dodam
DB_USER=dodam
DB_PASSWORD=dodam_local

# Use a random secret with at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32
DEMO_LOGIN=true
H2_CONSOLE=false
SERVER_PORT=8081
FRONTEND_ORIGIN=http://localhost:4173
SPRING_FLYWAY_IGNORE_MIGRATION_PATTERNS=*:ignored

# Government24 public welfare service API. Never commit the real service key.
GOV24_WELFARE_BASE_URL=https://api.odcloud.kr/api
GOV24_WELFARE_SERVICE_KEY=
GOV24_WELFARE_PAGE_SIZE=100
GOV24_WELFARE_CONNECT_TIMEOUT=2s
GOV24_WELFARE_READ_TIMEOUT=10s
GOV24_WELFARE_SYNC_ENABLED=false

# Local folder for uploaded originals. Empty uses ./data/object-storage.
STORAGE_LOCAL_ROOT=

# AI analysis server. Empty AI_BASE_URL skips the analysis request (no-op).
AI_BASE_URL=
AI_INTERNAL_TOKEN=
